---
import { businessOffer } from '../data/offer';
import Button from './ui/Button.astro';
---

<section
  id="biznes"
  class="relative overflow-hidden border-t border-mc-white/5 py-20 md:py-28"
  aria-labelledby="business-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="geo-ring absolute -right-24 top-1/2 h-[420px] w-[420px] -translate-y-1/2 opacity-[0.06] md:h-[560px] md:w-[560px]"
    >
    </div>
    <div class="geo-line absolute left-0 top-1/3 w-full opacity-10"></div>
    <span
      class="absolute right-8 top-8 font-display text-[clamp(4rem,12vw,8rem)] font-extrabold uppercase leading-none text-mc-white/[0.025] md:right-12"
      aria-hidden="true"
    >
      B2B
    </span>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="reveal lg:col-span-7" data-reveal>
        <p class="font-display text-xs font-bold uppercase tracking-[0.35em] text-mc-orange">
          {businessOffer.label}
        </p>
        <h2
          id="business-heading"
          class="mt-5 font-display text-3xl font-extrabold uppercase leading-tight tracking-tight text-mc-white md:text-5xl lg:text-[3.25rem]"
        >
          {businessOffer.headline}
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mc-muted md:text-xl">
          {businessOffer.description}
        </p>

        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-4" role="list">
          {
            businessOffer.focusAreas.map((area) => (
              <li>
                <span class="font-display text-sm font-bold uppercase tracking-[0.3em] text-mc-white/70">
                  {area}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal lg:col-span-4 lg:col-start-9 lg:pb-2" data-reveal data-reveal-delay="100">
        <div class="border-l border-mc-white/15 pl-8 md:pl-10">
          <Button href="#kontakt" variant="secondary">
            {businessOffer.cta}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
