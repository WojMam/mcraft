---
import { businessOffer } from '../data/offer';
import Button from './ui/Button.astro';
---

<section
  id="biznes"
  class="relative overflow-x-clip border-t border-mc-white/5 py-[var(--section-py-md)] md:py-28"
  aria-labelledby="business-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="geo-ring absolute -right-24 top-1/2 h-[420px] w-[420px] -translate-y-1/2 opacity-[0.06] md:h-[560px] md:w-[560px]"
    >
    </div>
    <div class="geo-line absolute left-0 top-1/3 w-full opacity-10"></div>
    <span
      class="type-signature absolute right-6 top-6 text-[clamp(2.5rem,14vw,8rem)] uppercase leading-none text-mc-white/[0.02] md:right-12 md:top-8"
      aria-hidden="true"
    >
      B2B
    </span>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="reveal lg:col-span-7" data-reveal>
        <p class="type-eyebrow text-xs uppercase tracking-[0.35em] text-mc-orange">
          {businessOffer.label}
        </p>
        <h2
          id="business-heading"
          class="type-editorial mt-5 text-[clamp(1.85rem,4vw,3.15rem)] uppercase leading-[1.08] tracking-tight text-mc-white text-balance"
        >
          {businessOffer.headline}
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mc-muted md:text-xl">
          {businessOffer.description}
        </p>

        <ul class="mt-8 grid grid-cols-1 gap-3 sm:max-w-xs md:mt-10 lg:flex lg:max-w-none lg:flex-wrap lg:gap-x-8 lg:gap-y-4" role="list">
          {
            businessOffer.focusAreas.map((area) => (
              <li>
                <span class="type-eyebrow text-sm uppercase tracking-[0.28em] text-mc-white/70">
                  {area}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal lg:col-span-4 lg:col-start-9 lg:pb-2" data-reveal data-reveal-delay="100">
        <div class="border-l border-mc-white/15 pl-0 lg:pl-8 xl:pl-10">
          <Button href="#kontakt" variant="secondary" class="w-full py-3.5 lg:w-auto lg:py-4">
            {businessOffer.cta}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
