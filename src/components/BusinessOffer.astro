---
import { businessOffer } from '../data/offer';
import Button from './ui/Button.astro';
---

<section
  id="biznes"
  class="border-t border-mc-white/5 py-20 md:py-24"
  aria-labelledby="business-heading"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div
      class="reveal flex flex-col gap-8 border-l border-mc-white/10 py-4 pl-8 md:flex-row md:items-center md:justify-between md:pl-12"
      data-reveal
    >
      <div class="max-w-2xl">
        <p
          class="font-display text-xs font-bold uppercase tracking-[0.3em] text-mc-muted"
        >
          {businessOffer.label}
        </p>
        <h2
          id="business-heading"
          class="mt-3 font-display text-2xl font-bold uppercase tracking-wide text-mc-white/80 md:text-3xl"
        >
          {businessOffer.headline}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-mc-muted">
          {businessOffer.description}
        </p>
      </div>
      <Button href="#kontakt" variant="secondary" class="shrink-0 self-start md:self-center">
        {businessOffer.cta}
      </Button>
    </div>
  </div>
</section>
