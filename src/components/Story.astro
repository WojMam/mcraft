---
import { story } from '../data/story';
import { photoSlots } from '../data/photos';
import SectionLabel from './ui/SectionLabel.astro';
import PhotoFrame from './ui/PhotoFrame.astro';
---

<section
  id="historia"
  class="relative -mt-[clamp(3.5rem,12vh,6.5rem)] overflow-hidden pt-10 pb-24 md:pt-14 md:pb-28"
  aria-labelledby="story-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg
      class="absolute bottom-0 left-0 h-full w-full opacity-[0.03]"
      viewBox="0 0 1440 800"
      preserveAspectRatio="xMidYMax slice"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        points="0,600 360,300 720,500 1080,200 1440,450 1440,800 0,800"
        stroke="currentColor"
        stroke-width="1"
        fill="none"></polyline>
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal max-w-4xl" data-reveal>
      <SectionLabel text={story.label} />
      <h2
        id="story-heading"
        class="type-editorial mt-6 max-w-5xl text-[clamp(2rem,5.5vw,4.25rem)] uppercase leading-[1.05] tracking-tight text-balance"
      >
        {story.headline}
        <span class="type-signature mt-2 block tracking-tighter text-mc-orange">{story.headlineAccent}</span>
      </h2>
    </div>

    <!-- Editorial photo collage — full container width for aligned right edge -->
    <div class="reveal relative mt-14 md:mt-16" data-reveal data-reveal-delay="100">
      <div class="relative w-full md:min-h-[28rem] lg:min-h-[32rem]">
        <div
          class="relative z-10 w-full md:absolute md:left-0 md:top-0 md:w-[68%] lg:w-[65%]"
        >
          <PhotoFrame
            src={photoSlots.storyOutdoor.src}
            alt={photoSlots.storyOutdoor.alt}
            fade="bottom"
            class="aspect-[16/10] w-full shadow-[0_24px_48px_-12px_rgba(0,0,0,0.55)] md:aspect-[16/9]"
          />
        </div>
        <div
          class="relative z-20 mt-4 w-[72%] max-w-xs md:absolute md:bottom-0 md:right-0 md:mt-0 md:w-[38%] lg:w-[36%]"
        >
          <PhotoFrame
            src={photoSlots.storyActivity.src}
            alt={photoSlots.storyActivity.alt}
            fade="left"
            class="aspect-[3/4] w-full shadow-[0_20px_40px_-10px_rgba(0,0,0,0.5)] md:-translate-y-6 lg:-translate-y-10"
          />
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-7 lg:col-span-7">
        {
          story.paragraphs.map((paragraph, i) => (
            <p
              class="reveal text-lg leading-relaxed text-mc-muted md:text-xl"
              data-reveal
              data-reveal-delay={i * 70}
            >
              {paragraph}
            </p>
          ))
        }
        <p
          class="reveal border-l-2 border-mc-orange pl-6 text-lg font-medium leading-relaxed text-mc-white md:text-xl"
          data-reveal
          data-reveal-delay="300"
        >
          {story.closing}
        </p>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <div class="reveal lg:sticky lg:top-32" data-reveal data-reveal-delay="150">
          {
            story.pillars.map((pillar) => (
              <div class="border-t border-mc-white/10 py-5">
                <p class="type-editorial text-xl uppercase tracking-[0.04em] text-mc-white">
                  {pillar.label}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-mc-muted">{pillar.detail}</p>
              </div>
            ))
          }
          <div class="border-t border-mc-white/10"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #historia {
    background: linear-gradient(
      180deg,
      var(--color-mc-black) 0%,
      var(--color-mc-surface) 50%,
      var(--color-mc-black) 100%
    );
  }
</style>
