---
import { story } from '../data/story';
import SectionLabel from './ui/SectionLabel.astro';
---

<section
  id="historia"
  class="relative overflow-hidden py-32 md:py-40"
  aria-labelledby="story-heading"
>
  <!-- Decorative mountain-inspired geometry -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg
      class="absolute bottom-0 left-0 h-full w-full opacity-[0.03]"
      viewBox="0 0 1440 800"
      preserveAspectRatio="xMidYMax slice"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        points="0,600 360,300 720,500 1080,200 1440,450 1440,800 0,800"
        stroke="currentColor"
        stroke-width="1"
        fill="none"></polyline>
      <polyline
        points="0,700 480,400 960,550 1440,350 1440,800 0,800"
        stroke="currentColor"
        stroke-width="0.5"
        fill="none"></polyline>
    </svg>
    <div
      class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-mc-surface to-transparent"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal max-w-4xl" data-reveal>
      <SectionLabel text={story.label} />
      <h2
        id="story-heading"
        class="mt-6 font-display text-4xl font-extrabold uppercase leading-tight tracking-tight md:text-6xl lg:text-7xl"
      >
        {story.headline}
        <span class="mt-2 block text-mc-orange">{story.headlineAccent}</span>
      </h2>
    </div>

    <div class="mt-20 grid gap-16 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-8 lg:col-span-7">
        {
          story.paragraphs.map((paragraph, i) => (
            <p
              class="reveal text-lg leading-relaxed text-mc-muted md:text-xl"
              data-reveal
              data-reveal-delay={i * 80}
            >
              {paragraph}
            </p>
          ))
        }
        <p
          class="reveal border-l-2 border-mc-orange pl-6 text-lg font-medium leading-relaxed text-mc-white md:text-xl"
          data-reveal
          data-reveal-delay="400"
        >
          {story.closing}
        </p>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <div class="reveal space-y-0 lg:sticky lg:top-32" data-reveal data-reveal-delay="200">
          {
            story.pillars.map((pillar, i) => (
              <div class="border-t border-mc-white/10 py-6">
                <p class="font-display text-2xl font-extrabold uppercase tracking-wide text-mc-white">
                  {pillar.label}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-mc-muted">
                  {pillar.detail}
                </p>
              </div>
            ))
          }
          <div class="border-t border-mc-white/10"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #historia {
    background: linear-gradient(
      180deg,
      var(--color-mc-black) 0%,
      var(--color-mc-surface) 50%,
      var(--color-mc-black) 100%
    );
  }
</style>
