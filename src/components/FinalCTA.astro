---
import { finalCta, contactForm } from '../data/offer';
import { photoSlots } from '../data/photos';
import Button from './ui/Button.astro';
import PhotoFrame from './ui/PhotoFrame.astro';
---

<section
  id="kontakt"
  class="contact-section relative overflow-x-clip py-[var(--section-py-md)] md:py-28"
  aria-labelledby="contact-heading"
>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-[32%] opacity-30 lg:block xl:w-[28%]"
    aria-hidden="true"
  >
    <PhotoFrame
      src={photoSlots.ctaPortrait.src}
      alt=""
      fade="left"
      class="h-full w-full"
      imgClass="object-top opacity-60"
    />
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-10">
      <div class="relative z-10 lg:col-span-5">
        <p
          class="type-eyebrow reveal mb-4 text-xs uppercase tracking-[0.3em] text-mc-orange"
          data-reveal
        >
          Napisz do mnie
        </p>
        <h2
          id="contact-heading"
          class="type-editorial reveal text-[clamp(1.75rem,4.2vw,2.85rem)] uppercase leading-[1.12] tracking-tight text-balance"
          data-reveal
        >
          {finalCta.headline}
          <span class="mt-2 block text-mc-orange">{finalCta.headlineAccent}</span>
        </h2>
        <p class="reveal mt-5 max-w-sm text-base leading-relaxed text-mc-muted md:mt-6 md:text-lg" data-reveal data-reveal-delay="100">
          {finalCta.subline}
        </p>
      </div>

      <div class="reveal relative z-10 lg:col-span-6 lg:col-start-7" data-reveal data-reveal-delay="200">
        <form
          id="contact-form"
          class="contact-form w-full space-y-4 border border-mc-white/10 bg-mc-black/85 p-5 backdrop-blur-sm md:space-y-5 md:p-7"
          novalidate
          data-contact-form
        >
          <div>
            <label for="contact-name" class="mb-1.5 block text-xs uppercase tracking-widest text-mc-muted md:mb-2 md:text-sm">
              {contactForm.nameLabel}
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              autocomplete="name"
              placeholder={contactForm.namePlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-3.5 py-2.5 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none md:px-4 md:py-3"
            />
          </div>

          <div>
            <label for="contact-email" class="mb-1.5 block text-xs uppercase tracking-widest text-mc-muted md:mb-2 md:text-sm">
              {contactForm.emailLabel}
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              autocomplete="email"
              placeholder={contactForm.emailPlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-3.5 py-2.5 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none md:px-4 md:py-3"
            />
          </div>

          <div>
            <label for="contact-message" class="mb-1.5 block text-xs uppercase tracking-widest text-mc-muted md:mb-2 md:text-sm">
              {contactForm.messageLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder={contactForm.messagePlaceholder}
              class="w-full resize-y border border-mc-white/15 bg-mc-surface px-3.5 py-2.5 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none md:px-4 md:py-3"
            ></textarea>
          </div>

          <div>
            <Button type="submit" variant="primary" class="w-full py-3.5 md:w-auto md:py-4" disabled>
              {contactForm.submitLabel}
            </Button>
          </div>

          <p class="text-sm text-mc-muted">{contactForm.unavailableNote}</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      ellipse 120% 80% at 50% 100%,
      rgba(232, 93, 4, 0.07) 0%,
      rgba(120, 45, 8, 0.025) 28%,
      transparent 62%
    );
  }

  @media (min-width: 1024px) {
    .contact-section::before {
      background: radial-gradient(
        ellipse 90% 70% at 35% 100%,
        var(--mc-orange-glow) 0%,
        transparent 70%
      );
    }
  }
</style>

