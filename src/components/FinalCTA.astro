---
import { finalCta, contactForm } from '../data/offer';
import { photoSlots } from '../data/photos';
import Button from './ui/Button.astro';
import PhotoFrame from './ui/PhotoFrame.astro';
---

<section
  id="kontakt"
  class="relative overflow-hidden py-24 md:py-28"
  aria-labelledby="contact-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(ellipse_at_bottom,var(--mc-orange-glow),transparent_70%)]"
    >
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-[32%] opacity-30 lg:block xl:w-[28%]"
    aria-hidden="true"
  >
    <PhotoFrame
      src={photoSlots.ctaPortrait.src}
      alt=""
      fade="left"
      class="h-full w-full"
      imgClass="object-top opacity-60"
    />
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-10">
      <div class="relative z-10 lg:col-span-5">
        <p
          class="type-eyebrow reveal mb-4 text-xs uppercase tracking-[0.3em] text-mc-orange"
          data-reveal
        >
          Napisz do mnie
        </p>
        <h2
          id="contact-heading"
          class="type-editorial reveal text-[clamp(1.75rem,4.2vw,2.85rem)] uppercase leading-[1.12] tracking-tight text-balance"
          data-reveal
        >
          {finalCta.headline}
          <span class="mt-2 block text-mc-orange">{finalCta.headlineAccent}</span>
        </h2>
        <p class="reveal mt-6 max-w-sm text-lg text-mc-muted" data-reveal data-reveal-delay="100">
          {finalCta.subline}
        </p>
      </div>

      <div class="reveal relative z-10 lg:col-span-6 lg:col-start-7" data-reveal data-reveal-delay="200">
        <form
          id="contact-form"
          class="w-full space-y-5 border border-mc-white/10 bg-mc-black/85 p-6 backdrop-blur-sm md:p-7"
          novalidate
          data-contact-form
        >
          <div>
            <label for="contact-name" class="mb-2 block text-sm uppercase tracking-widest text-mc-muted">
              {contactForm.nameLabel}
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              autocomplete="name"
              placeholder={contactForm.namePlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-email" class="mb-2 block text-sm uppercase tracking-widest text-mc-muted">
              {contactForm.emailLabel}
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              autocomplete="email"
              placeholder={contactForm.emailPlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            />
          </div>

          <div>
            <label for="contact-message" class="mb-2 block text-sm uppercase tracking-widest text-mc-muted">
              {contactForm.messageLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder={contactForm.messagePlaceholder}
              class="w-full resize-y border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            ></textarea>
          </div>

          <div>
            <Button type="submit" variant="primary" class="w-full md:w-auto" disabled>
              {contactForm.submitLabel}
            </Button>
          </div>

          <p class="text-sm text-mc-muted">{contactForm.unavailableNote}</p>
        </form>
      </div>
    </div>
  </div>
</section>

