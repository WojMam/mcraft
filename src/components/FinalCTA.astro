---
import { finalCta, contactForm } from '../data/offer';
import Button from './ui/Button.astro';
---

<section
  id="kontakt"
  class="relative overflow-hidden py-32 md:py-40"
  aria-labelledby="contact-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(ellipse_at_bottom,var(--mc-orange-glow),transparent_70%)]"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2
          id="contact-heading"
          class="reveal font-display text-4xl font-extrabold uppercase leading-tight tracking-tight md:text-5xl lg:text-6xl"
          data-reveal
        >
          {finalCta.headline}
          <span class="mt-2 block text-mc-orange">{finalCta.headlineAccent}</span>
        </h2>
        <p
          class="reveal mt-6 text-lg text-mc-muted"
          data-reveal
          data-reveal-delay="100"
        >
          {finalCta.subline}
        </p>
      </div>

      <div class="reveal" data-reveal data-reveal-delay="200">
        <form
          id="contact-form"
          class="space-y-6"
          novalidate
          data-contact-form
        >
          <div>
            <label
              for="contact-name"
              class="mb-2 block text-sm uppercase tracking-widest text-mc-muted"
            >
              {contactForm.nameLabel}
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              autocomplete="name"
              placeholder={contactForm.namePlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            />
          </div>

          <div>
            <label
              for="contact-email"
              class="mb-2 block text-sm uppercase tracking-widest text-mc-muted"
            >
              {contactForm.emailLabel}
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              placeholder={contactForm.emailPlaceholder}
              class="w-full border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            />
          </div>

          <div>
            <label
              for="contact-message"
              class="mb-2 block text-sm uppercase tracking-widest text-mc-muted"
            >
              {contactForm.messageLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="5"
              placeholder={contactForm.messagePlaceholder}
              class="w-full resize-y border border-mc-white/15 bg-mc-surface px-4 py-3 text-mc-white placeholder:text-mc-muted/50 transition-colors focus:border-mc-orange focus:outline-none"
            ></textarea>
          </div>

          <div>
            <Button type="submit" variant="primary" class="w-full md:w-auto">
              {contactForm.submitLabel}
            </Button>
          </div>

          <p
            id="contact-success"
            class="hidden text-mc-orange"
            role="status"
            aria-live="polite"
          >
            {contactForm.successMessage}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

