---
import { navigation, ctaLabel } from '../data/navigation';
import { withBase } from '../utils/withBase';
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  data-header
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="#" class="relative z-10 shrink-0" aria-label="Mental Craft — strona główna">
      <img
        src={withBase('assets/logo/header.png')}
        alt="Mental Craft"
        class="hidden h-8 w-auto md:block"
        width="200"
        height="32"
      />
      <img
        src={withBase('assets/logo/symbol.png')}
        alt="Mental Craft"
        class="h-9 w-9 md:hidden"
        width="36"
        height="36"
      />
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Nawigacja główna">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="text-sm uppercase tracking-widest text-mc-muted transition-colors hover:text-mc-white"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#kontakt"
        class="type-ui bg-mc-orange px-6 py-2.5 text-xs uppercase tracking-widest text-mc-black transition-colors hover:bg-mc-orange-dim"
      >
        {ctaLabel}
      </a>
    </nav>

    <button
      type="button"
      class="relative z-10 flex h-10 w-10 flex-col items-center justify-center gap-1.5 lg:hidden"
      aria-label="Otwórz menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="block h-0.5 w-6 bg-mc-white transition-all" data-bar="1"></span>
      <span class="block h-0.5 w-6 bg-mc-white transition-all" data-bar="2"></span>
      <span class="block h-0.5 w-4 bg-mc-orange transition-all" data-bar="3"></span>
    </button>
  </div>

  <div
    class="fixed inset-0 z-40 flex translate-x-full flex-col bg-mc-black/98 backdrop-blur-sm transition-transform duration-500 lg:hidden"
    data-mobile-menu
    aria-hidden="true"
  >
    <nav class="flex flex-1 flex-col justify-center gap-8 px-10" aria-label="Menu mobilne">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="text-3xl font-medium uppercase tracking-[0.06em] text-mc-white transition-colors hover:text-mc-orange"
            data-menu-link
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#kontakt"
        class="type-ui mt-4 inline-block bg-mc-orange px-8 py-4 text-sm uppercase tracking-widest text-mc-black"
        data-menu-link
      >
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  [data-header].is-scrolled {
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(245, 245, 240, 0.06);
  }

  [data-mobile-menu].is-open {
    transform: translateX(0);
  }

  [data-menu-toggle].is-open [data-bar='1'] {
    transform: translateY(8px) rotate(45deg);
  }

  [data-menu-toggle].is-open [data-bar='2'] {
    opacity: 0;
  }

  [data-menu-toggle].is-open [data-bar='3'] {
    width: 1.5rem;
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
