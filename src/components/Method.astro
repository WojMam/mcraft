---
import { methodSteps } from '../data/method';
import { site } from '../data/site';
---

<section id="metoda" aria-label="Metoda Mental Craft">
  {
    methodSteps.map((step, index) => (
      <article
        class="relative flex min-h-screen items-center overflow-hidden py-24"
        aria-labelledby={`method-${step.id}`}
      >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          {step.accent === 'left' && (
            <div class="absolute -left-40 top-1/2 h-[600px] w-[600px] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,var(--mc-orange-glow),transparent_70%)]" />
          )}
          {step.accent === 'center' && (
            <div class="geo-line absolute left-0 top-1/2 w-full opacity-20" />
          )}
          {step.accent === 'right' && (
            <div class="absolute -right-32 bottom-0 h-[500px] w-[500px] bg-[radial-gradient(circle_at_bottom_right,rgba(232,93,4,0.08),transparent_60%)]" />
          )}
          <span class="absolute right-6 top-1/2 -translate-y-1/2 font-display text-[20vw] font-extrabold leading-none text-mc-white/[0.02] md:right-16">
            {String(index + 1).padStart(2, '0')}
          </span>
        </div>

        <div class="relative mx-auto w-full max-w-7xl px-6 lg:px-10">
          {index === 0 && (
            <p
              class="reveal mb-8 font-display text-xs font-bold uppercase tracking-[0.4em] text-mc-orange"
              data-reveal
            >
              {site.tagline}
            </p>
          )}

          <h2
            id={`method-${step.id}`}
            class="reveal font-display text-[clamp(3.5rem,12vw,10rem)] font-extrabold uppercase leading-[0.9] tracking-tighter"
            data-reveal
            data-reveal-delay="100"
          >
            {step.title}
          </h2>

          <p
            class="reveal mt-10 max-w-xl text-xl leading-relaxed text-mc-muted md:mt-14 md:max-w-2xl md:text-2xl"
            data-reveal
            data-reveal-delay="200"
          >
            {step.description}
          </p>
        </div>
      </article>
    ))
  }
</section>
