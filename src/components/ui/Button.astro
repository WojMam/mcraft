---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
}

const {
  href = '#',
  variant = 'primary',
  class: className = '',
  type,
  disabled = false,
} = Astro.props;

const base =
  'type-ui inline-flex items-center justify-center uppercase tracking-widest text-sm transition-colors duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-mc-orange';

const variants = {
  primary:
    'bg-mc-orange text-mc-black px-8 py-4 hover:bg-mc-orange-dim disabled:opacity-50 disabled:cursor-not-allowed',
  secondary:
    'border border-mc-white/30 text-mc-white px-8 py-4 hover:border-mc-orange hover:text-mc-orange',
  ghost: 'text-mc-muted hover:text-mc-orange px-2 py-2',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{
  type === 'submit' || type === 'button' ? (
    <button type={type ?? 'button'} class={classes} disabled={disabled}>
      <slot />
    </button>
  ) : (
    <a href={href} class={classes}>
      <slot />
    </a>
  )
}
