---
import { site } from '../data/site';
import { withBase } from '../utils/withBase';
---

<footer class="border-t border-mc-white/5 py-8 md:py-16">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-10">
      <div>
        <img
          src={withBase('assets/logo/footer.png')}
          alt="Mental Craft"
          class="h-16 w-auto md:h-20"
          width="120"
          height="80"
        />
        <p class="mt-4 text-sm text-mc-muted">
          © {site.year} {site.brand}. Wszelkie prawa zastrzeżone.
        </p>
      </div>

      <div class="text-sm text-mc-muted">
        <p class="type-eyebrow text-xs uppercase tracking-[0.3em] text-mc-white/40">
          {site.tagline}
        </p>
        <p class="mt-2">{site.author}</p>
      </div>
    </div>
  </div>
</footer>
