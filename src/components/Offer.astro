---
import { offerOneOnOne } from '../data/offer';
import SectionLabel from './ui/SectionLabel.astro';
import Button from './ui/Button.astro';
---

<section
  id="oferta"
  class="relative overflow-hidden py-24 md:py-28"
  aria-labelledby="offer-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-0 top-0 h-full w-1/3 bg-gradient-to-r from-[rgba(232,93,4,0.04)] to-transparent"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="reveal lg:sticky lg:top-32" data-reveal>
          <SectionLabel text={offerOneOnOne.label} />
          <h2
            id="offer-heading"
            class="mt-6 font-display text-4xl font-extrabold uppercase leading-none tracking-tight md:text-6xl"
          >
            {offerOneOnOne.headline}
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-mc-muted md:text-xl">
            {offerOneOnOne.subline}
          </p>
          <p
            class="mt-8 inline-block border border-mc-orange/40 px-4 py-2 font-display text-sm font-bold uppercase tracking-widest text-mc-orange"
          >
            {offerOneOnOne.sessions}
          </p>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="reveal mb-12" data-reveal>
          <p
            class="mb-5 font-display text-xs font-bold uppercase tracking-[0.35em] text-mc-orange"
          >
            {offerOneOnOne.sessionAnatomyLabel}
          </p>
          <div class="grid gap-3 sm:grid-cols-3">
            {
              offerOneOnOne.sessionStructure.map((block) => (
                <div class="border border-mc-white/10 bg-mc-surface/40 px-5 py-6">
                  <p class="font-display text-3xl font-extrabold tabular-nums leading-none text-mc-white md:text-4xl">
                    {block.duration.split(' ')[0]}
                    <span class="ml-1 text-sm font-bold uppercase tracking-[0.2em] text-mc-orange">
                      {block.duration.split(' ')[1]}
                    </span>
                  </p>
                  <p class="mt-3 font-display text-sm font-bold uppercase tracking-[0.25em] text-mc-white/80">
                    {block.label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <ul class="space-y-0" role="list">
          {
            offerOneOnOne.processElements.map((element, i) => (
              <li
                class="reveal border-t border-mc-white/10 py-6"
                data-reveal
                data-reveal-delay={i * 60}
              >
                <div class="flex gap-5">
                  <span
                    class="font-display text-2xl font-extrabold text-mc-white/10"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p class="text-base leading-relaxed text-mc-white md:text-lg">{element}</p>
                </div>
              </li>
            ))
          }
          <li class="border-t border-mc-white/10" aria-hidden="true"></li>
        </ul>

        <p class="reveal mt-8 text-sm italic text-mc-muted" data-reveal>
          {offerOneOnOne.note}
        </p>

        <div class="reveal mt-10" data-reveal>
          <Button href="#kontakt" variant="primary">{offerOneOnOne.cta}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
