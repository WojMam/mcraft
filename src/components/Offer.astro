---
import { offerOneOnOne } from '../data/offer';
import SectionLabel from './ui/SectionLabel.astro';
import Button from './ui/Button.astro';
---

<section
  id="oferta"
  class="relative overflow-hidden py-32 md:py-40"
  aria-labelledby="offer-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-0 top-0 h-full w-1/3 bg-gradient-to-r from-[rgba(232,93,4,0.04)] to-transparent"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="reveal lg:sticky lg:top-32" data-reveal>
          <SectionLabel text={offerOneOnOne.label} />
          <h2
            id="offer-heading"
            class="mt-6 font-display text-5xl font-extrabold uppercase leading-none tracking-tight md:text-7xl"
          >
            {offerOneOnOne.headline}
          </h2>
          <p class="mt-6 text-xl leading-relaxed text-mc-muted">
            {offerOneOnOne.subline}
          </p>
          <p
            class="mt-8 inline-block border border-mc-orange/40 px-4 py-2 font-display text-sm font-bold uppercase tracking-widest text-mc-orange"
          >
            {offerOneOnOne.sessions}
          </p>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <ul class="space-y-0" role="list">
          {
            offerOneOnOne.elements.map((element, i) => (
              <li
                class="reveal border-t border-mc-white/10 py-8"
                data-reveal
                data-reveal-delay={i * 80}
              >
                <div class="flex gap-6">
                  <span
                    class="font-display text-3xl font-extrabold text-mc-white/10"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p class="text-lg leading-relaxed text-mc-white md:text-xl">
                    {element}
                  </p>
                </div>
              </li>
            ))
          }
          <li class="border-t border-mc-white/10" aria-hidden="true"></li>
        </ul>

        <p
          class="reveal mt-10 text-mc-muted italic"
          data-reveal
          data-reveal-delay="400"
        >
          {offerOneOnOne.note}
        </p>

        <div class="reveal mt-12" data-reveal data-reveal-delay="500">
          <Button href="#kontakt" variant="primary">{offerOneOnOne.cta}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
