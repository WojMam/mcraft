---
import { ebookTeaser } from '../data/offer';
import SectionLabel from './ui/SectionLabel.astro';
import { withBase } from '../utils/withBase';
---

<section
  id="workbook"
  class="relative overflow-x-clip border-t border-mc-white/5 py-[var(--section-py-sm)] md:py-24"
  aria-labelledby="workbook-heading"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-5" data-reveal>
        <div
          class="workbook-mockup relative mx-auto aspect-[3/4] max-w-[15rem] sm:max-w-xs"
          aria-label="Wizualizacja koncepcyjna okładki workbooka"
        >
          <div class="workbook-mockup__back" aria-hidden="true"></div>
          <div class="workbook-mockup__cover">
            <img
              src={withBase('assets/logo/symbol.png')}
              alt=""
              class="h-10 w-10 opacity-80 sm:h-12 sm:w-12"
              width="48"
              height="48"
              aria-hidden="true"
            />
            <div class="mt-auto">
              <p class="type-eyebrow text-[0.65rem] uppercase tracking-[0.28em] text-mc-orange sm:text-xs">
                Mental Craft
              </p>
              <p
                class="type-editorial mt-2 max-w-[9rem] text-lg uppercase leading-[1.05] sm:max-w-[10rem] sm:text-xl"
              >
                Podręcznik<br />warsztatowy
              </p>
            </div>
            <div class="h-0.5 w-10 bg-mc-orange"></div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="reveal" data-reveal data-reveal-delay="100">
          <SectionLabel text={ebookTeaser.label} />
          <h2
            id="workbook-heading"
            class="type-editorial mt-5 text-[clamp(1.85rem,3.5vw,2.5rem)] uppercase leading-[1.1] tracking-tight text-balance"
          >
            {ebookTeaser.headline}
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-mc-muted md:text-lg">
            {ebookTeaser.description}
          </p>
          <button
            type="button"
            class="type-ui mt-8 cursor-not-allowed border border-mc-white/15 bg-mc-surface/40 px-8 py-3 text-xs uppercase tracking-widest text-mc-muted/90"
            disabled
            aria-disabled="true"
          >
            {ebookTeaser.cta}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .workbook-mockup {
    perspective: 900px;
  }

  .workbook-mockup__back {
    position: absolute;
    inset: 0.35rem -0.5rem -0.35rem 0.5rem;
    background: var(--color-mc-surface-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transform: rotate(-3deg);
    box-shadow: 0 18px 36px -14px rgba(0, 0, 0, 0.65);
  }

  .workbook-mockup__cover {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(165deg, var(--color-mc-surface) 0%, var(--color-mc-black) 100%);
    padding: 1.5rem;
    transform: rotate(-1.5deg);
    box-shadow:
      0 24px 48px -16px rgba(0, 0, 0, 0.7),
      inset 1px 0 0 rgba(255, 255, 255, 0.06);
  }

  .workbook-mockup__cover::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
  }
</style>

