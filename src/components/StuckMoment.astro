---
import { stuckMoment } from '../data/content';
---

<section
  id="problem"
  class="relative flex min-h-0 items-center overflow-x-clip py-16 md:min-h-[85vh] md:py-24"
  aria-labelledby="stuck-heading"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute left-1/2 top-1/2 h-[min(480px,90vw)] w-[min(480px,90vw)] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(circle,rgba(232,93,4,0.04),transparent_65%)] md:h-[800px] md:w-[800px]"
    >
    </div>
  </div>

  <!-- Background typography — anchored left, slight right bleed -->
  <h2
    id="stuck-heading"
    class="type-signature pointer-events-none absolute left-3 top-[14%] z-0 max-w-[92vw] text-[clamp(2.25rem,16vw,9.5rem)] uppercase leading-none tracking-tighter text-mc-white/[0.06] sm:left-4 md:left-8 md:top-[18%] md:max-w-[96vw] md:text-[clamp(3rem,10.5vw,9.5rem)] md:text-mc-white/[0.07]"
    aria-hidden="true"
  >
    {stuckMoment.headline}
  </h2>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-10">
    <div class="relative pt-20 sm:pt-24 md:pt-[clamp(6rem,16vw,10rem)]">
      <p
        class="reveal max-w-3xl text-xl font-medium leading-snug text-mc-white sm:text-2xl md:text-4xl lg:text-5xl"
        data-reveal
      >
        {stuckMoment.lead}
      </p>

      <ul class="mt-10 space-y-0 md:mt-14" role="list">
        {
          stuckMoment.situations.map((situation, i) => (
            <li
              class="reveal group border-t border-mc-white/10 py-5 md:py-8"
              data-reveal
              data-reveal-delay={150 + i * 70}
            >
              <div class="flex items-start gap-6 md:gap-10">
                <span
                  class="type-ui mt-1 text-sm tabular-nums text-mc-orange"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="max-w-2xl text-lg leading-relaxed text-mc-muted transition-colors group-hover:text-mc-white md:text-xl">
                  {situation}
                </p>
              </div>
            </li>
          ))
        }
        <li class="border-t border-mc-white/10" aria-hidden="true"></li>
      </ul>
    </div>
  </div>
</section>
